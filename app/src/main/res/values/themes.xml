<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.VntApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#4F46E5</item>
        <item name="colorPrimaryVariant">#4338CA</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#4F46E5</item>
        <item name="android:fontFamily">sans</item>
        <item name="colorSecondaryVariant">#4338CA</item>
        <item name="colorOnSecondary">@color/black</item>
        <!--
          targetSdk 36 起系统强制 edge-to-edge，statusBarColor 不再生效。
          系统栏保持透明，由界面自行按 window inset 让出刘海和手势区，
          内容背景直接延伸到屏幕边缘。
        -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
